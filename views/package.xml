<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="package_tree_id" model="ir.ui.view">
        <field name="name">package_tree</field>
        <field name="model">package</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
                <field name="subscriber_ids"/>
                <field name="durations"/>
                <field name="months"/>
            </tree>
        </field>
    </record>

     <record id="package_form_id" model="ir.ui.view">
        <field name="name">package_form</field>
        <field name="model">package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="get_all_sub" icon="fa-user" type="object" class="oe_stat_button">
                            <field name="count_subscribers" widget="statinfo" string="Subscribers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h3>
                            <label for="name"/>
                        </h3>
                        <field name="name"/>
                    </div>
                    <group col="2">
                        <group string="First">
                            <field name="price"/>
                            <field name="months"/>
                            <field name="durations"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="package_actions" model="ir.actions.act_window">
        <field name="name">package</field>
        <field name="res_model">package</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
         id="package_id"
         name="package"
         parent="gym_id"
         action="package_actions"
         sequence="2"
    />
</odoo>
