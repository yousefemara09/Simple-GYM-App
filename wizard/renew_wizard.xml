<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="renew_wizard" model="ir.ui.view">
        <field name="name">renew wizard</field>
        <field name="model">renew.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                            <field name="state"/>
                            <field name="months"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="renew_wizard_actions" model="ir.actions.act_window">
        <field name="name">renew.wizard</field>
        <field name="res_model">renew.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
